---
// 這是全站共用的版面框架，每個頁面都會「包」在這個框架裡
// 之後想改全站的 header、字體、配色，只要改這一個檔案，不用每頁改
interface Props {
  title: string; // 每個頁面自己傳入不同的網頁標題
}
const { title } = Astro.props;
---
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Skate Matters</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="site-nav">
      <a href="/" class="brand-mark">Skate Matters</a>
