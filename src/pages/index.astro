---
// 服務項目清單，之後要加/改項目只要改這裡
const services = [
  { name: "個人一對一課程", desc: "適合初學者到進階，客製化教學進度" },
  { name: "小組課程", desc: "2-4人一組，適合朋友、親子一起學" },
  { name: "學校 / 機構課程", desc: "與學校或機構合作，團體教學方案" },
  { name: "企業 / 活動體驗", desc: "公司活動、生日會等滑板體驗活動" },
];

const whatsappLink = "https://wa.me/85291688089";
---
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Skate Matters | 香港滑板私人教練</title>
    <!-- 引入襯線字體，營造書法/浮世繪風格的文字質感 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="hero">
      <div class="hero-frame">
        <p class="eyebrow">香港 · 私人滑板教練</p>
        <h1>Skate Matters</h1>
        <p class="tagline">學校、私人場地、企業活動皆可安排</p>
        <a class="btn-seal" href={whatsappLink} target="_blank">
          WhatsApp 查詢
        </a>
      </div>
    </header>

    <section class="services">
      <h2>教學項目</h2>
      <div class="service-grid">
        {services.map((s) => (
          <div class="service-card">
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="portfolio">
      <h2>作品集</h2>
      <p><a href="https://www.instagram.com/lopmxlpm" target="_blank">個人 Instagram @lopmxlpm</a></p>
      <p><a href="https://www.instagram.com/Skate_Matters" target="_blank">品牌 Instagram @Skate_Matters</a></p>
    </section>

    <footer class="contact">
      <h2>預約查詢</h2>
      <p>歡迎透過 WhatsApp 直接查詢課程時間與價格</p>
      <a class="btn-seal" href={whatsappLink} target="_blank">
        9168 8089
      </a>
    </footer>

    <style>
      /* 全域色票：靛藍夜空、夕陽橘紅、米色木紋、印章紅 */
      :root {
        --indigo: #1c2b45;
        --sunset: #c1512e;
        --sunset-light: #e0946a;
        --cream: #f2e6d0;
        --wood: #6b4a30;
        --seal-red: #a83226;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Noto Serif TC", serif;
        background: var(--cream);
        color: var(--indigo);
      }

      /* Hero 區：模擬夕陽漸層天空 */
      .hero {
        background: linear-gradient(
          to bottom,
          var(--indigo) 0%,
          var(--sunset-light) 55%,
          var(--cream) 100%
        );
        padding: 5rem 1.5rem 4rem;
        text-align: center;
      }

      /* 木牌匾風格的邊框，包住標題文字 */
      .hero-frame {
        max-width: 600px;
        margin: 0 auto;
        border: 4px double var(--wood);
        padding: 2.5rem 1.5rem;
        background: rgba(242, 230, 208, 0.9);
      }

      .eyebrow {
        letter-spacing: 0.3em;
        font-size: 0.85rem;
        color: var(--wood);
        margin: 0 0 0.5rem;
      }

      .hero h1 {
        font-size: 3rem;
        font-weight: 900;
        margin: 0 0
