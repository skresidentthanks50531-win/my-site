---
// 這裡放要顯示的服務項目資料，之後想加/改項目，只要改這個列表就好
const services = [
  { name: "個人一對一課程", desc: "適合初學者到進階，客製化教學進度" },
  { name: "小組課程", desc: "2-4人一組，適合朋友、親子一起學" },
  { name: "學校 / 機構課程", desc: "與學校或機構合作，團體教學方案" },
  { name: "企業 / 活動體驗", desc: "公司活動、生日會等滑板體驗活動" },
];

const whatsappLink = "https://wa.me/85291688089";
---
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Skate Matters | 香港滑板私人教練</title>
  </head>
  <body>
    <header class="hero">
      <h1>Skate Matters</h1>
      <p>香港註冊滑板私人教練 — 學校、私人場地、企業活動皆可安排</p>
      <a class="btn-primary" href={whatsappLink} target="_blank">
        WhatsApp 立即查詢
      </a>
    </header>

    <section class="services">
      <h2>教學項目</h2>
      <div class="service-grid">
        {services.map((s) => (
          <div class="service-card">
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="portfolio">
      <h2>作品集</h2>
      <p><a href="https://www.instagram.com/lopmxlpm" target="_blank">個人 Instagram @lopmxlpm</a></p>
      <p><a href="https://www.instagram.com/Skate_Matters" target="_blank">品牌 Instagram @Skate_Matters</a></p>
    </section>

    <footer class="contact">
      <h2>預約查詢</h2>
      <p>歡迎透過 WhatsApp 直接查詢課程時間與價格</p>
      <a class="btn-primary" href={whatsappLink} target="_blank">
        WhatsApp：9168 8089
      </a>
    </footer>

    <style>
      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        color: #1a1a1a;
        background: #fafafa;
      }
      .hero {
        text-align: center;
        padding: 4rem 1.5rem;
        background: #111;
        color: #fff;
      }
      .hero h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
      }
      .hero p {
        margin-bottom: 1.5rem;
        opacity: 0.85;
      }
      .btn-primary {
        display: inline-block;
        background: #25d366;
        color: #fff;
        padding: 0.8rem 1.8rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: bold;
      }
      .services, .portfolio, .contact {
        max-width: 800px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        text-align: center;
      }
      .service-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.2rem;
        margin-top: 1.5rem;
        text-align: left;
      }
      .service-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
        padding: 1.2rem;
      }
      .service-card h3 {
        margin-top: 0;
      }
      .contact {
        background: #111;
        color: #fff;
      }
      .contact .btn-primary {
        margin-top: 1rem;
      }
    </style>
  </body>
</html>
