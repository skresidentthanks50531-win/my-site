---
const services = [
  { name: "個人一對一課程", desc: "適合初學者到進階，客製化教學進度" },
  { name: "小組課程", desc: "2-4人一組，適合朋友、親子一起學" },
  { name: "學校 / 機構課程", desc: "與學校或機構合作，團體教學方案" },
  { name: "企業 / 活動體驗", desc: "公司活動、生日會等滑板體驗活動" },
];

const whatsappLink = "https://wa.me/85291688089";
const igPersonal = "https://www.instagram.com/lopmxlpm";
const igBrand = "https://www.instagram.com/Skate_Matters";

// 精選的 IG 貼文
const highlights = [
  "https://www.instagram.com/p/DWYFvGrEeyG/",
  "https://www.instagram.com/p/DXI7HUckdfe/",
  "https://www.instagram.com/p/C37YELFr46c/",
  "https://www.instagram.com/p/DbFNslVkTAe/",
  "https://www.instagram.com/p/DaRvsE9RAwu/",
];
---
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Skate Matters | 香港滑板私人教練</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="hero">
      <div class="hero-frame">
        <p class="eyebrow">香港 · 私人滑板教練</p>
        <h1>Skate Matters</h1>
        <p class="tagline">學校、私人場地、企業活動皆可安排</p>
        <div class="cta-row">
          <a class="btn-seal" href="#services">找教練</a>
          <a class="btn-seal btn-outline" href="#gallery">逛品牌</a>
        </div>
      </div>
    </header>

    <section id="services" class="services">
      <h2>教學項目</h2>
      <div class="service-grid">
        {services.map((s) => (
          <div class="service-card">
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="gallery" class="portfolio">
      <h2>作品集</h2>
      <div class="ig-row">
        <a class="ig-link" href={igPersonal} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
