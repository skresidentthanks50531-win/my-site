---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const services = [
  { name: "個人一對一課程", desc: "適合初學者到進階，客製化教學進度", link: "/coaching/adult" },
  { name: "小組課程", desc: "2-4人一組，適合朋友、親子一起學", link: "/coaching/group" },
  { name: "學校 / 機構課程", desc: "與學校或機構合作，團體教學方案", link: "/coaching/group" },
  { name: "兒童班", desc: "專為兒童設計的滑板入門課程", link: "/coaching/kids" },
];
---
<BaseLayout title="首頁">
  <header class="hero">
    <div class="hero-frame">
      <p class="eyebrow">香港 · 私人滑板教練</p>
      <h1>Skate Matters</h1>
      <p class="tagline">學校、私人場地、企業活動皆可安排</p>
      <div class="cta-row">
        <a class="btn-seal" href="#services">找教練</a>
        <a class="btn-seal btn-outline" href="/brand">逛品牌</a>
      </div>
    </div>
  </header>

  <section id="services" class="services">
    <h2>教學項目</h2>
    <div class="service-grid">
      {services.map((s) => (
        <a href={s.link} class="service-card">
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <footer class="contact">
    <h2>預約查詢</h2>
    <p>歡迎透過 WhatsApp 直接查詢課程時間與價格</p>
    <WhatsAppButton message="你好，我想查詢滑板課程" />
  </footer>

  <style>
    .hero {
      background: linear-gradient(to bottom, var(--indigo) 0%, var(--sunset-light) 55%, var(--cream) 100%);
      padding: clamp(2.5rem, 8vw, 5rem) 1.2rem clamp(2rem, 6vw, 4rem);
      text-align: center;
    }
    .hero-frame {
      max-width: 600px;
      margin: 0 auto;
      border: 4px double var(--wood);
      padding: clamp(1.5rem, 5vw, 2.5rem) 1.2rem;
      background: rgba(242, 230, 208, 0.9);
    }
    .eyebrow { letter-spacing: 0.3em; font-size: 0.8rem; color: var(--wood); margin: 0 0 0.5rem; }
    .hero h1 { font-size: clamp(2rem, 8vw, 3rem); font-weight: 900; margin: 0 0 0.5rem; color: var(--seal-red); }
    .tagline { color: var(--indigo); margin-bottom: 1.8rem; font-size: clamp(0.9rem, 3vw, 1rem); }
    .cta-row { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    a.btn-outline { background-color: transparent !important; color: var(--indigo) !important; border: 2px solid var(--seal-red); }

    .services { max-width: 900px; margin: 0 auto; padding: clamp(2rem, 6vw, 3.5rem) 1.2rem; text-align: center; }
    .services h2, .contact h2 {
      font-size: clamp(1.3rem, 4vw, 1.6rem);
      border-bottom: 3px solid var(--sunset);
      display: inline-block;
      padding-bottom: 0.4rem;
      margin-bottom: 2rem;
    }
    .service-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.2rem; text-align: left; }
    .service-card {
      background: #fff;
      border: 2px solid var(--wood);
      padding: 1.2rem;
      text-decoration: none !important;
      color: var(--indigo) !important;
      display: block;
    }
    .service-card h3 { margin-top: 0; color: var(--seal-red); font-size: 1.05rem; }

    .contact { background: var(--indigo); color: var(--cream); text-align: center; padding: clamp(2rem, 6vw, 3.5rem) 1.2rem; }
    .contact h2 { border-bottom-color: var(--sunset-light); }

    @media (max-width: 480px) {
      .cta-row { flex-direction: column; align-items: center; }
      a.btn-seal { width: 100%; max-width: 280px; text-align: center; }
    }
  </style>
</BaseLayout>
