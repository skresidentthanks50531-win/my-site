---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const igPersonal = "https://www.instagram.com/lopmxlpm";
const igBrand = "https://www.instagram.com/Skate_Matters";

const posts = [
  "https://www.instagram.com/p/DWYFvGrEeyG/",
  "https://www.instagram.com/p/DXI7HUckdfe/",
  "https://www.instagram.com/p/C37YELFr46c/",
  "https://www.instagram.com/p/DbFNslVkTAe/",
  "https://www.instagram.com/p/DaRvsE9RAwu/",
];
---
<BaseLayout title="作品集">
  <section class="gallery-page">
    <h1>作品集</h1>
    <p class="intro">
      精選教學、活動與品牌日常，更多內容歡迎追蹤 Instagram
    </p>

    <div class="follow-row">
      <a href={igPersonal} target="_blank" rel="noopener" class="ig-link">
        個人 @lopmxlpm
      </a>
      <a href={igBrand} target="_blank" rel="noopener" class="ig-link">
        品牌 @Skate_Matters
      </a>
    </div>

    <div class="ig-embed-grid">
      {posts.map((url) => (
        <div class="ig-embed-item">
          <blockquote
            class="instagram-media"
            data-instgrm-permalink={url}
            data-instgrm-version="14"
          ></blockquote>
        </div>
      ))}
    </div>

    <div class="cta-block">
      <p>想預約課程或了解更多，歡迎直接查詢</p>
      <WhatsAppButton message="你好，我想查詢滑板課程" />
    </div>
  </section>

  <script async src="//www.instagram.com/embed.js"></script>

  <style>
    .gallery-page {
      max-width: 900px;
      margin: 0 auto;
      padding: clamp(2rem, 6vw, 3.5rem) 1.2rem;
      text-align: center;
    }
    .gallery-page h1 {
      font-size: clamp(1.8rem, 6vw, 2.4rem);
      color: var(--seal-red);
      margin-bottom: 0.6rem;
    }
    .intro {
      margin-bottom: 1.5rem;
    }
    .follow-row {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .ig-link {
      border: 2px solid var(--wood);
      padding: 0.6rem 1.2rem;
      border-radius: 999px;
      text-decoration: none !important;
      color: var(--indigo) !important;
      font-size: 0.9rem;
    }
    .ig-embed-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      justify-items: center;
      margin-bottom: 3rem;
    }
    .ig-embed-item {
      width: 100%;
      max-width: 340px;
    }
    .cta-block {
      background: var(--indigo);
      color: var(--cream);
      padding: clamp(1.5rem, 5vw, 2rem);
    }
    .cta-block p {
      margin-bottom: 1rem;
    }
  </style>
</BaseLayout>
